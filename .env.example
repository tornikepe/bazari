# Copy to .env and adjust.

# PostgreSQL connection string. Works with any Postgres — Prisma Postgres,
# Neon, Supabase, Railway or a local server. Fastest way to get one:
#   npx create-db@latest
DATABASE_URL="postgresql://user:password@localhost:5432/bazari?schema=public"

# Signs the session cookie. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"

# Seeded admin account. There is no default password — the seed refuses to run
# without one, so no deployment ends up with a password that is public in a
# repository. Generate it with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# ---------------------------------------------------------------------------
# Seeded accounts
# ---------------------------------------------------------------------------
# `npx prisma db seed` creates exactly these three and refuses to run without
# their passwords. Nothing is defaulted: a password that ships in a repository
# is a password on every deployment that forgot to change it.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
#
# See the README section "Accounts and passwords" for the full explanation.

# Full staff access — can change anything in the dashboard. Minimum 12 chars.
ADMIN_EMAIL="admin@bazari.ge"
ADMIN_PASSWORD=""

# Read-only staff. Sees every dashboard page and can change none of them. Held
# to the same 12-character minimum: it cannot write, but it can read every
# order, address and margin in the shop.
VIEWER_EMAIL="viewer@bazari.ge"
VIEWER_PASSWORD=""

# The demo shopper, so the account area and checkout can be tried without
# signing up. Minimum 8 characters — it owns nothing but its own test orders,
# so a memorable one is fine.
CUSTOMER_EMAIL="user@bazari.ge"
CUSTOMER_PASSWORD=""

# Transactional email (verification codes, password resets). Without a key the
# codes are written to the server log in development and nothing is sent in
# production — they are never returned to the browser.
#   https://resend.com  →  API Keys
RESEND_API_KEY=""
# Must be a sender on a domain you have verified with the provider.
MAIL_FROM="Bazari <noreply@yourdomain.ge>"

# ---------------------------------------------------------------------------
# Contact assistant
#
# Without any key below, the chat launcher is simply not rendered — the shop
# works exactly as before. Set ONE of the two.

# Free tier. This is the default, and what makes the assistant switched on
# without a card on file.
#   https://aistudio.google.com/apikey
# Note: on Google's free tier, conversations are used to improve Google's
# products. The privacy page says so — keep it that way if you change this.
GEMINI_API_KEY=""

# Paid, and the better answer. Used automatically if it's the only key set.
#   https://console.anthropic.com  →  API Keys
ANTHROPIC_API_KEY=""

# Optional. With both keys set, Gemini wins by default because it's free;
# set this to "anthropic" to pay for the better model instead. A value naming
# a provider with no key switches the assistant OFF rather than falling back —
# so a forgotten key is visible, not silently served by the free tier.
CHAT_PROVIDER=""

# Ceiling on what the assistant may cost per calendar month, in USD. Counted
# from the token usage each response reports, not estimated. Defaults to 5.
# On a free tier this can never fire — see the request cap below.
CHAT_MONTHLY_BUDGET_USD="5"

# Optional ceiling on requests per calendar month. Unset means not enforced.
# This is the one that does the work on a free tier, where no number of
# requests can ever add up to a cost: it stops one determined visitor from
# burning the daily quota everyone else shares.
CHAT_MONTHLY_REQUEST_CAP=""

# ---------------------------------------------------------------------------
# Social sign-in (optional)
# ---------------------------------------------------------------------------
# Each provider's button only appears when BOTH of its values are set, so an
# unconfigured deployment shows a plain email form rather than a button that
# fails after a round trip. Leave them blank to turn the feature off.
#
# Google:   https://console.cloud.google.com/apis/credentials
#           Create an "OAuth 2.0 Client ID" of type "Web application" and add
#           this exact redirect URI:
#             https://<your-domain>/api/auth/google/callback
#
# Facebook: https://developers.facebook.com/apps
#           Add the "Facebook Login" product and set the redirect URI to:
#             https://<your-domain>/api/auth/facebook/callback
#           Facebook only returns an email once it has confirmed it, and this
#           app refuses a sign-in without one — so the app needs the `email`
#           permission approved before it works for people outside your test
#           users.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
