# Copy to .env and adjust.

# PostgreSQL connection string. Works with any Postgres — Prisma Postgres,
# Neon, Supabase, Railway or a local server. Fastest way to get one:
#   npx create-db@latest
DATABASE_URL="postgresql://user:password@localhost:5432/bazari?schema=public"

# Signs the session cookie. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"

# Seeded admin account. There is no default password — the seed refuses to run
# without one, so no deployment ends up with a password that is public in a
# repository. Generate it with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_EMAIL="admin@bazari.ge"
ADMIN_PASSWORD=""

# Transactional email (verification codes, password resets). Without a key the
# codes are written to the server log in development and nothing is sent in
# production — they are never returned to the browser.
#   https://resend.com  →  API Keys
RESEND_API_KEY=""
# Must be a sender on a domain you have verified with the provider.
MAIL_FROM="Bazari <noreply@yourdomain.ge>"

# Contact assistant. Without a key the chat launcher is simply not rendered —
# the shop works exactly as before.
#   https://console.anthropic.com  →  API Keys
ANTHROPIC_API_KEY=""
# Ceiling on what the assistant may cost per calendar month, in USD. Counted
# from the token usage the API reports, not estimated. Once reached the chat
# declines politely until the 1st. Defaults to 5.
CHAT_MONTHLY_BUDGET_USD="5"
