#!/bin/sh
#
# Refuse to push commits GitHub will not attribute to anybody.
#
# This repository once accumulated thirty commits with no author: `user.email`
# was never set, so git fell back to `tornike@Tornikes-MacBook-Pro.local`,
# which is not an address GitHub knows. Every one of them showed as an unlinked
# avatar and none reached the contribution graph. It went unnoticed for weeks,
# and fixing it meant rewriting history and force-pushing.
#
# The failure is silent by design — git is happy, the push succeeds, and the
# only symptom is an empty square on a page nobody checks daily. So the check
# belongs here, at the last moment before the mistake leaves the machine.
#
# Install once per clone:
#     git config core.hooksPath .githooks

if [ -z "$(git config user.email)" ]; then
  echo "pre-push: git user.email is not set."
  echo "  Commits made without it are not attributed to your GitHub account,"
  echo "  and never appear on your contribution graph."
  echo
  echo "  Fix:  git config --global user.email \"<id>+<user>@users.noreply.github.com\""
  exit 1
fi

# Git feeds pre-push one line per ref being updated, on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
#
# Reading that rather than `@{push}` matters: `@{push}` does not resolve on a
# branch's first push, and an earlier version of this hook swallowed that
# error and passed — the one push where an unattributed commit is most likely
# is the first one from a fresh clone.
empty="0000000000000000000000000000000000000000"
failed=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$empty" ] && continue          # branch deletion

  if [ "$remote_sha" = "$empty" ]; then
    # New branch: everything on it that the remote does not already have.
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  # GitHub links a commit by its author email. A `.local` suffix is a hostname
  # git invented for a machine, which is the exact shape of the original bug.
  bad=$(git log --pretty='%h %ae  %s' $range 2>/dev/null | grep -E '@[^ ]*\.(local|lan|home)  ' || true)

  if [ -n "$bad" ]; then
    echo "pre-push: refusing — these commits carry a machine-local author address:"
    echo "$bad" | sed 's/^/  /'
    failed=1
  fi
done

if [ "$failed" = 1 ]; then
  echo
  echo "  GitHub cannot link them to your account, so they will not appear on"
  echo "  your contribution graph. Repair them with:"
  echo "    git rebase -i --exec 'git commit --amend --no-edit --reset-author' <base>"
  exit 1
fi

exit 0
