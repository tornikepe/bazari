// Bazari — schema for a demo retail storefront.
// Every user-facing string is duplicated per locale (ka / en).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  /// Full staff access: sees the dashboard and can change what is on it.
  admin
  /// Staff, read-only. Sees every dashboard page and no write control on any
  /// of them. Enforced in the Server Actions, not by hiding buttons — the
  /// actions are reachable by direct POST.
  viewer
}

/// What a one-time code is for. The same table serves both flows, so codes
/// can't be replayed across them.
enum TokenPurpose {
  email_verification
  password_reset
}

enum PaymentMethod {
  cash_on_delivery
  card
  bank_transfer
}

/// Which gateway handled a payment. `manual` covers cash on delivery and
/// bank transfer, where no gateway is involved at all; real adapters are added
/// here as they are integrated.
enum PaymentProvider {
  manual
}

/// Lifecycle of one payment attempt. An order can have several — a failed card
/// attempt followed by a successful one is normal.
enum PaymentState {
  /// Created; the shopper has not come back from the gateway yet.
  pending
  /// Funds reserved but not taken (providers that separate the two).
  authorized
  /// Money actually taken — this is what flips the order to `paid`.
  captured
  failed
  cancelled
  /// Nobody came back and the window elapsed.
  expired
  refunded
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

/// Why a product's stock changed, so the ledger explains itself.
enum StockReason {
  restock
  sale
  correction
  return_to_stock
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameKa    String
  nameEn    String
  icon      String    @default("📦")
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

/// Money is stored in **tetri as whole numbers**, never as a float.
///
/// 0.1 + 0.2 is not 0.3 in binary floating point, and `(5.555).toFixed(2)` is
/// "5.55" rather than "5.56" because the value sits a hair below the decimal.
/// Neither is acceptable for deciding what a card is charged, so every amount
/// in this schema is an integer and only the display layer divides by 100.
model Product {
  id            String      @id @default(cuid())
  slug          String      @unique
  nameKa        String
  nameEn        String
  descriptionKa String      @default("")
  descriptionEn String      @default("")
  sku           String      @unique
  price         Int
  oldPrice      Int?
  /// What the shop paid. Drives the margin figures in the dashboard.
  costPrice     Int       @default(0)
  stock         Int         @default(0)
  /// Alert threshold — below this the dashboard flags the product.
  lowStockAt    Int         @default(10)
  image         String      @default("/products/placeholder.svg")
  brand         String      @default("")
  shippingDays  Int         @default(14)
  isFeatured    Boolean     @default(false)
  isActive      Boolean     @default(true)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  stockMoves    StockMovement[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
}

/// Append-only stock ledger. Every change to `Product.stock` writes a row, so
/// "why is this product out of stock?" is always answerable.
model StockMovement {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Signed: negative for sales, positive for restocks.
  delta     Int
  reason    StockReason
  /// Stock level after this movement, so history survives later edits.
  balance   Int
  note      String      @default("")
  /// Set when the movement came from an order, so the ledger row can be
  /// traced back to the sale or cancellation that caused it.
  orderId   String?
  order     Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([orderId])
}

/// Percentage or fixed-amount discount codes.
model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  /// Percent off when `percentOff` is set, otherwise a flat `amountOff`.
  percentOff    Int?
  amountOff     Int?
  minOrderTotal Int     @default(0)
  maxUses       Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  orders        Order[]
  createdAt     DateTime  @default(now())

  @@index([isActive])
}

model Order {
  id           String      @id @default(cuid())
  number       String      @unique
  /// Null for guest checkout — an account isn't required to order.
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName String
  phone        String
  email        String      @default("")
  city         String
  address      String
  note         String      @default("")

  /// Money is stored broken down, not just as a total, so an invoice can be
  /// reproduced exactly even after prices or shipping rules change.
  subtotal     Int       @default(0)
  shipping     Int       @default(0)
  discount     Int       @default(0)
  total        Int

  couponId     String?
  coupon       Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)

  paymentMethod PaymentMethod @default(cash_on_delivery)
  paymentStatus PaymentStatus @default(unpaid)

  status       OrderStatus @default(pending)
  /// Set when the order reaches `shipped` / `delivered`.
  shippedAt    DateTime?
  deliveredAt  DateTime?

  items        OrderItem[]
  events       OrderEvent[]
  movements    StockMovement[]
  payments     Payment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([paymentStatus])
}

/// Status-change history for an order — who moved it and when.
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String      @default("")
  /// Email of the staff member, or empty when the system did it.
  actor     String      @default("")
  createdAt DateTime    @default(now())

  @@index([orderId])
}

/// Name/price are snapshotted so an order stays readable after a product edit.
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  nameKa    String
  nameEn    String
  sku       String   @default("")
  image     String   @default("/products/placeholder.svg")
  price     Int
  /// Snapshotted alongside the price so past margins don't move when the
  /// product's cost is later updated.
  costPrice Int    @default(0)
  quantity  Int

  @@index([orderId])
}

/// Both customers and staff live here — `role` is what separates the customer
/// account area from the admin dashboard.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  phone     String   @default("")
  city      String   @default("")
  address   String   @default("")
  password  String
  role      Role     @default(customer)
  /// Sign-up sends a code; until it's confirmed this stays false.
  emailVerified Boolean @default(false)
  /// Bumped to invalidate every session cookie issued for this user. The
  /// cookie carries the value it was signed with, so an old one no longer
  /// matches and is rejected without needing a session table.
  sessionVersion Int    @default(0)
  orders    Order[]
  tokens    VerificationToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

/// Short-lived one-time codes for email verification and password resets.
///
/// Only a hash of the code is stored, so a database leak can't be replayed
/// against either flow.
model VerificationToken {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  purpose   TokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Fixed-window counters for rate limiting.
///
/// Kept in Postgres rather than Redis so the app needs no second datastore:
/// auth endpoints see little traffic, and one indexed upsert per attempt is
/// cheap. The counter is bumped atomically, so concurrent attempts from the
/// same client can't slip past the limit.
model RateLimit {
  /// "<action>:<scope>:<identifier>", e.g. "login:ip:1.2.3.4".
  key      String   @id
  count    Int      @default(0)
  /// Start of the window the count belongs to.
  windowAt DateTime @default(now())

  @@index([windowAt])
}

/// One attempt to collect money for an order.
///
/// Amounts are held in **minor units** (tetri) as integers. The rest of the
/// schema uses Float for prices, which is fine for display but must never
/// decide what a card is charged — 0.1 + 0.2 is not 0.3 in binary floating
/// point, and a payment that disagrees with the gateway by a tetri is a
/// reconciliation problem.
model Payment {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider    PaymentProvider
  /// The gateway's own identifier for this attempt, once it has issued one.
  providerRef String?
  state       PaymentState    @default(pending)

  /// Charged amount in tetri, copied from the order when the attempt starts.
  amount      Int
  currency    String          @default("GEL")
  /// Set once money has actually moved back out again.
  refunded    Int             @default(0)

  /// Attempts that are never completed are swept to `expired` after this.
  expiresAt   DateTime
  capturedAt  DateTime?
  failReason  String          @default("")

  events      PaymentEvent[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([orderId])
  @@index([state])
  @@unique([provider, providerRef])
}

/// Token spend for the contact assistant, one row per calendar month.
///
/// The assistant calls a metered API, so without a ceiling a scripted client
/// could run up a bill overnight. Rate limiting caps *requests* per browser;
/// this caps *money* for the whole shop, which is the number that actually
/// matters. Both are needed — a thousand people asking one question each
/// passes every per-browser limit there is.
///
/// Counted rather than estimated: the figures come from `usage` on each API
/// response, so the cap tracks the real bill instead of a guess about it.
model ChatUsage {
  /// "YYYY-MM" in UTC. A new month is a new row, so the budget resets itself.
  month            String   @id
  requests         Int      @default(0)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  /// Cached prefixes are billed differently, so they're counted separately —
  /// folding them into `inputTokens` would overstate the bill by ~10x on a
  /// cache hit and understate it on a write.
  cacheWriteTokens Int      @default(0)
  cacheReadTokens  Int      @default(0)
  updatedAt        DateTime @updatedAt
}

/// Raw gateway callbacks, kept so a payment can always be explained.
///
/// `externalId` is unique: gateways retry webhooks, and replaying one must not
/// capture an order twice.
model PaymentEvent {
  id         String   @id @default(cuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// The gateway's event id, or a hash of the body when it doesn't send one.
  externalId String
  state      PaymentState
  /// Verbatim payload, for disputes and debugging.
  payload    String   @default("")
  createdAt  DateTime @default(now())

  @@unique([paymentId, externalId])
  @@index([paymentId])
}

/// Everything about the shop that is not a product.
///
/// One row, pinned to `id = "shop"`. Deliberately a table with columns rather
/// than a key/value store: the types are worth having. `freeShippingThreshold`
/// is an integer of tetri and the schema says so, instead of it being a string
/// four different callers have to agree how to parse.
model ShopSettings {
  id String @id @default("shop")

  name          String @default("Bazari")
  /// Appended after the name in the browser tab, per language.
  titleSuffixKa String @default("ონლაინ მაღაზია")
  titleSuffixEn String @default("online store")
  taglineKa     String @default("")
  taglineEn     String @default("")
  logoUrl       String @default("")

  /// All optional. The contact page renders what is set and omits what is not,
  /// rather than showing an empty row — a shop without a phone number yet
  /// should say nothing, not show a dash.
  contactEmail   String @default("")
  contactPhone   String @default("")
  contactAddress String @default("")
  contactHoursKa String @default("")
  contactHoursEn String @default("")

  /// One hex colour, lowercase, `#rrggbb`. The ten brand shades and the
  /// button tokens are derived from it at render time for both themes — see
  /// `brand-theme.ts`. A database constraint holds the format so nothing can
  /// reach the stylesheet that is not a colour.
  brandColor            String  @default("#dc1f24")

  currencySymbol        String  @default("₾")
  /// Tetri, like every other amount in this schema.
  freeShippingThreshold Int     @default(20000)
  shippingFee           Int     @default(1500)
  codEnabled            Boolean @default(true)

  updatedAt DateTime @updatedAt
}

/// An uploaded product photo, kept in the database.
///
/// Postgres rather than object storage because object storage needs an account
/// and a token, and this has to work the moment somebody clones the project.
/// `Product.image` holds a short `/api/images/<id>` URL rather than the bytes,
/// so the catalogue's list queries — which select `image` for every card — stay
/// as cheap as they were when it held a path.
///
/// Swapping in Vercel Blob later changes only where the upload route writes to;
/// nothing that reads a product needs to know the difference.
model ProductImage {
  id          String   @id @default(cuid())
  data        Bytes
  contentType String
  /// What the file was called when it was chosen, for the dashboard to show.
  filename    String   @default("")
  bytes       Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// A footer information page — about, FAQ, shipping, returns, and so on.
///
/// Bilingual columns rather than a row per language, matching `Category` and
/// `Product`: one page is one row, and its two languages are edited together
/// because they are the same page.
///
/// `bodyKa` / `bodyEn` hold the small text format in `info-content.ts`, where
/// `## ` starts a section. Figures are written as placeholders — `{freeShipping}`
/// resolves from settings at render, so a page cannot state a delivery rule the
/// checkout no longer applies.
model InfoPage {
  slug        String  @id
  titleKa     String  @default("")
  titleEn     String  @default("")
  introKa     String  @default("")
  introEn     String  @default("")
  bodyKa      String  @default("")
  bodyEn      String  @default("")
  /// Unpublished pages are hidden from the footer rather than rendered empty.
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)
  updatedAt   DateTime @updatedAt
}
