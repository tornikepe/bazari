# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. The README opens with `cp .env.example .env`, so a
# clone that doesn't contain it starts with a file-not-found. It holds only
# placeholders — every secret in it is an empty string.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vendored AI-agent tooling (installed locally, not part of the app)
/.agents
/.windsurf
/.claude/skills
skills-lock.json

/src/generated/prisma

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
